{
  "name": "claudekit-cli",
  "version": "1.0.0",
  "description": "ClaudeKit CLI Tool",
  "type": "module",
  "bin": {
    "ck": "./bin/ck.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node",
    "start": "node dist/index.js",
    "lint": "bunx tsc --noEmit",
    "test": "bun test",
    "sync": "../scripts/sync-kit.sh"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@commitlint/cli": "^20.3.1",
    "@types/diff": "^8.0.0",
    "@types/minimatch": "^6.0.0",
    "cac": "^6.7.14",
    "diff": "^8.0.3",
    "hash-wasm": "^4.12.0",
    "minimatch": "^10.1.1",
    "simple-git": "^3.30.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
